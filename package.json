{
  "name": "prompt-generator",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "firebase": "^12.11.0",
    "framer-motion": "^12.42.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "sass": "^1.97.0",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=1",
    "typecheck": "tsc -b",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:functions": "eslint functions/src",
    "format": "prettier --write \"*.{js,json,ts}\" .prettierrc.json \"src/components/ui/{AppErrorBoundary,ErrorFallback}.tsx\"",
    "format:check": "prettier --check \"*.{js,json,ts}\" .prettierrc.json \"src/components/ui/{AppErrorBoundary,ErrorFallback}.tsx\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:functions && npm run test:run && npm run build",
    "sync-shared": "cd functions && npm install ../shared --no-save"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rolldown/plugin-babel": "0.1.7",
    "@types/babel__core": "7.20.5",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fs-extra": "^11.3.3",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.2"
  }
}
